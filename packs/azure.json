{
  "$schema": "../schemas/pack.schema.json",
  "id": "azure",
  "version": "0.2.0",
  "label": "Microsoft Azure",
  "description": "Serverless (Functions, API Management, Cosmos DB, Blob Storage), web (Application Gateway, virtual machines, scale sets) and networking (virtual networks, subnets, NAT gateways, network security groups).",
  "vocabulary": 6,
  "requires": {
    "core": "^0.2.0"
  },
  "types": [
    {
      "id": "azure.function-app",
      "label": "Function app",
      "description": "Runs functions on demand. HTTP-triggered functions are called at the Azure Functions endpoint; its managed identity's role assignments decide what it may access. With virtual network integration, place it in a subnet: its outbound traffic then goes through the virtual network.",
      "category": "compute",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "ports": ["https"],
          "via": "provider"
        },
        "principal": {
          "grants": {
            "property": "roleAssignments"
          }
        },
        "access-controlled": {
          "levels": {
            "invoke": ["invoke"]
          },
          "public": {
            "property": "anonymous"
          },
          "publicActions": ["invoke"]
        },
        "redundancy": {
          "managed": {
            "property": "zoneRedundant"
          }
        }
      },
      "accepts": [
        {
          "from": {
            "type": "azure.api-management"
          },
          "actions": ["invoke"]
        },
        {
          "from": {
            "type": "azure.application-gateway"
          },
          "actions": ["invoke"]
        },
        {
          "from": {
            "category": "compute"
          },
          "actions": ["invoke"]
        },
        {
          "from": {
            "category": "external"
          },
          "actions": ["invoke"],
          "ports": ["https"]
        }
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "title": "Runtime",
          "description": "For example node or python. Informational only."
        },
        "anonymous": {
          "type": "boolean",
          "title": "Anonymous",
          "description": "The HTTP trigger's authorization level is anonymous: anyone may call it. Otherwise callers need a function key, which API Management and Application Gateway backends hold, or a role assignment.",
          "default": false
        },
        "roleAssignments": {
          "type": "array",
          "title": "Role assignments",
          "description": "What its managed identity may do. A new identity has no role assignments.",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "title": "Resource",
                "x-component-ref": true
              },
              "access": {
                "type": "string",
                "title": "Access",
                "enum": ["read", "write", "read-write", "invoke"]
              }
            },
            "required": ["resource", "access"]
          },
          "default": []
        },
        "zoneRedundant": {
          "type": "boolean",
          "title": "Zone redundant",
          "description": "Zone redundancy of its hosting plan (Flex Consumption, Premium or Dedicated). Without it, Azure does not spread it across availability zones.",
          "default": false
        }
      },
      "terraform": {
        "resource": "azurerm_linux_function_app",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          }
        },
        "notes": [
          "Set service_plan_id, the storage account and site_config. Its role assignments become azurerm_role_assignment resources, which are not exported."
        ]
      }
    },
    {
      "id": "azure.api-management",
      "label": "API Management",
      "description": "A managed API gateway that routes requests to backends such as function apps. Each API also holds the credentials to call its backend.",
      "category": "edge",
      "traits": {
        "endpoint": {
          "visibility": {
            "property": "endpoint"
          },
          "ports": ["https"]
        },
        "forwarder": {
          "routes": {
            "property": "apis"
          },
          "targetField": "backend",
          "authorizes": true
        },
        "redundancy": {
          "managed": {
            "property": "zoneRedundant"
          }
        }
      },
      "accepts": [
        {
          "actions": ["invoke"],
          "ports": ["https"]
        }
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "title": "Endpoint",
          "description": "public: reachable from the internet. private: internal virtual network mode; place it in a subnet.",
          "enum": ["public", "private"],
          "default": "public"
        },
        "apis": {
          "type": "array",
          "title": "APIs",
          "description": "Each API forwards requests on a path to a backend and holds the credentials to call it.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "title": "Path",
                "minLength": 1
              },
              "backend": {
                "type": "string",
                "title": "Backend",
                "x-component-ref": true
              }
            },
            "required": ["path", "backend"]
          },
          "default": []
        },
        "zoneRedundant": {
          "type": "boolean",
          "title": "Zone redundant",
          "description": "Premium tier with units in two or more availability zones.",
          "default": false
        }
      },
      "terraform": {
        "resource": "azurerm_api_management",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          }
        },
        "notes": [
          "Set publisher_name, publisher_email and sku_name. APIs and backends are not exported."
        ]
      }
    },
    {
      "id": "azure.cosmos-db",
      "label": "Cosmos DB account",
      "description": "A managed NoSQL database. Access requires a data-plane role assignment.",
      "category": "data-store",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "ports": ["https"]
        },
        "access-controlled": {
          "levels": {
            "read": ["read"],
            "write": ["write"],
            "read-write": ["read", "write"]
          }
        },
        "redundancy": {
          "managed": {
            "property": "zoneRedundant"
          }
        }
      },
      "accepts": [
        {
          "from": {
            "category": "compute"
          },
          "actions": ["read", "write"]
        }
      ],
      "properties": {
        "zoneRedundant": {
          "type": "boolean",
          "title": "Zone redundant",
          "description": "Availability zone support in its region. Without it, the account's replicas in a region may share one zone.",
          "default": false
        }
      },
      "terraform": {
        "resource": "azurerm_cosmosdb_account",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          },
          "offer_type": {
            "value": "Standard"
          }
        },
        "blocks": [
          {
            "name": "geo_location",
            "attributes": {
              "location": {
                "variable": "location"
              },
              "failover_priority": {
                "value": 0
              },
              "zone_redundant": {
                "property": "zoneRedundant"
              }
            }
          }
        ],
        "notes": ["Set a consistency_policy block."]
      }
    },
    {
      "id": "azure.blob-storage",
      "label": "Blob container",
      "description": "Object storage in a storage account. Access requires a role assignment unless anonymous read access is on.",
      "category": "data-store",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "ports": ["https"]
        },
        "access-controlled": {
          "levels": {
            "read": ["read"],
            "write": ["write"],
            "read-write": ["read", "write"]
          },
          "public": {
            "property": "anonymousRead"
          },
          "publicActions": ["read"]
        },
        "redundancy": {
          "managed": {
            "property": "zoneRedundant"
          }
        }
      },
      "accepts": [
        {
          "from": {
            "category": "compute"
          },
          "actions": ["read", "write"]
        },
        {
          "from": {
            "category": "external"
          },
          "actions": ["read"],
          "ports": ["https"]
        }
      ],
      "properties": {
        "anonymousRead": {
          "type": "boolean",
          "title": "Anonymous read",
          "description": "Whether anyone on the internet may read blobs. It also needs blob public access allowed on the storage account, which new accounts turn off.",
          "default": false
        },
        "zoneRedundant": {
          "type": "boolean",
          "title": "Zone redundant",
          "description": "ZRS or GZRS. LRS and GRS keep the copies in the primary region in one datacenter.",
          "default": false
        }
      },
      "terraform": {
        "resource": "azurerm_storage_container",
        "attributes": {
          "name": {
            "id": true
          },
          "container_access_type": {
            "property": "anonymousRead",
            "map": {
              "true": "blob",
              "false": "private"
            }
          }
        },
        "notes": [
          "Set storage_account_id of a storage account (azurerm_storage_account); zone redundancy is its account_replication_type, ZRS."
        ]
      }
    },
    {
      "id": "azure.vnet",
      "label": "Virtual network",
      "description": "A private network. Components in its subnets reach each other, subject to network security groups. Components with a public IP address reach the internet and can be reached from it through Azure's system routes; other components need a NAT gateway on their subnet to open connections to the internet. Subnets span every availability zone of the region.",
      "category": "network",
      "traits": {
        "zone": {
          "addressSpace": {
            "property": "addressSpace"
          },
          "directInternet": true
        }
      },
      "accepts": [],
      "properties": {
        "addressSpace": {
          "type": "string",
          "title": "Address space",
          "description": "The virtual network's IPv4 address range, for example 10.1.0.0/16. Used by the detailed analysis level.",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        }
      },
      "terraform": {
        "resource": "azurerm_virtual_network",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          },
          "address_space": {
            "property": "addressSpace",
            "list": true
          }
        }
      }
    },
    {
      "id": "azure.subnet",
      "label": "Subnet",
      "description": "A part of a virtual network; place it in the virtual network. A NAT gateway or a network security group can be associated with it.",
      "category": "network",
      "traits": {
        "zone": {
          "addressSpace": {
            "property": "addressPrefix"
          }
        }
      },
      "accepts": [],
      "properties": {
        "addressPrefix": {
          "type": "string",
          "title": "Address prefix",
          "description": "The subnet's IPv4 address range within its virtual network, for example 10.1.1.0/24. Used by the detailed analysis level.",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        }
      },
      "terraform": {
        "resource": "azurerm_subnet",
        "attributes": {
          "name": {
            "id": true
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          },
          "virtual_network_name": {
            "reference": "placement",
            "attribute": "name",
            "types": ["azure.vnet"]
          },
          "address_prefixes": {
            "property": "addressPrefix",
            "list": true
          }
        }
      }
    },
    {
      "id": "azure.nsg",
      "label": "Network security group",
      "description": "A stateful firewall for the subnets and components it is associated with. Its default rules allow traffic within the virtual network and outbound traffic to the internet.",
      "category": "network",
      "traits": {
        "traffic-filter": {
          "stateful": true,
          "attachTo": ["component", "zone"],
          "rules": {
            "property": "rules"
          },
          "targets": {
            "property": "associations"
          },
          "baseRules": [
            {
              "direction": "inbound",
              "peer": "network"
            },
            {
              "direction": "outbound",
              "peer": "network"
            },
            {
              "direction": "outbound",
              "peer": "internet"
            }
          ],
          "default": {
            "inbound": "deny",
            "outbound": "deny"
          }
        }
      },
      "accepts": [],
      "properties": {
        "rules": {
          "type": "array",
          "title": "Security rules",
          "description": "Checked in priority order (lowest number first); the first match decides. After them, the default rules allow traffic within the virtual network and outbound traffic to the internet, and deny everything else. Stateful: replies are allowed automatically.",
          "items": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "title": "Direction",
                "enum": ["inbound", "outbound"]
              },
              "peer": {
                "type": "string",
                "title": "Peer",
                "minLength": 1,
                "description": "any, internet, network (the VirtualNetwork service tag), the id of a component, subnet or virtual network, or an IPv4 range such as 10.0.0.0/16 (matched at the detailed level)."
              },
              "ports": {
                "type": "array",
                "title": "Ports",
                "items": {
                  "type": "string"
                },
                "description": "Port ids (https), numbers (443) or ranges (8080-8090). Omitted: all ports."
              },
              "effect": {
                "type": "string",
                "title": "Effect",
                "enum": ["allow", "deny"]
              }
            },
            "required": ["direction", "peer"]
          },
          "default": []
        },
        "associations": {
          "type": "array",
          "title": "Associations",
          "description": "The subnets and components (network interfaces) it is associated with.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "azurerm_network_security_group",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          }
        },
        "blocks": [
          {
            "name": "security_rule",
            "each": "rules",
            "where": {
              "direction": "inbound"
            },
            "expand": "ports",
            "attributes": {
              "name": {
                "index": {
                  "start": 100,
                  "step": 10
                },
                "prefix": "rule-"
              },
              "priority": {
                "index": {
                  "start": 100,
                  "step": 10
                }
              },
              "direction": {
                "value": "Inbound"
              },
              "access": {
                "property": "effect",
                "map": {
                  "allow": "Allow",
                  "deny": "Deny"
                },
                "default": "allow"
              },
              "protocol": {
                "port": "protocol",
                "property": "ports",
                "map": {
                  "-1": "*",
                  "tcp": "Tcp",
                  "udp": "Udp"
                }
              },
              "source_port_range": {
                "value": "*"
              },
              "destination_port_range": {
                "port": "range",
                "property": "ports"
              },
              "source_address_prefix": {
                "property": "peer",
                "map": {
                  "internet": "Internet",
                  "any": "*",
                  "network": "VirtualNetwork"
                },
                "ranges": true
              },
              "destination_address_prefix": {
                "value": "*"
              },
              "source_address_prefixes": {
                "reference": "peer",
                "attribute": "address_prefixes",
                "types": ["azure.subnet"]
              }
            },
            "requireAny": ["source_address_prefix", "source_address_prefixes"]
          },
          {
            "name": "security_rule",
            "each": "rules",
            "where": {
              "direction": "outbound"
            },
            "expand": "ports",
            "attributes": {
              "name": {
                "index": {
                  "start": 2000,
                  "step": 10
                },
                "prefix": "rule-"
              },
              "priority": {
                "index": {
                  "start": 2000,
                  "step": 10
                }
              },
              "direction": {
                "value": "Outbound"
              },
              "access": {
                "property": "effect",
                "map": {
                  "allow": "Allow",
                  "deny": "Deny"
                },
                "default": "allow"
              },
              "protocol": {
                "port": "protocol",
                "property": "ports",
                "map": {
                  "-1": "*",
                  "tcp": "Tcp",
                  "udp": "Udp"
                }
              },
              "source_port_range": {
                "value": "*"
              },
              "destination_port_range": {
                "port": "range",
                "property": "ports"
              },
              "destination_address_prefix": {
                "property": "peer",
                "map": {
                  "internet": "Internet",
                  "any": "*",
                  "network": "VirtualNetwork"
                },
                "ranges": true
              },
              "source_address_prefix": {
                "value": "*"
              },
              "destination_address_prefixes": {
                "reference": "peer",
                "attribute": "address_prefixes",
                "types": ["azure.subnet"]
              }
            },
            "requireAny": ["destination_address_prefix", "destination_address_prefixes"]
          }
        ],
        "extra": [
          {
            "resource": "azurerm_subnet_network_security_group_association",
            "suffix": "association",
            "each": "associations",
            "attributes": {
              "subnet_id": {
                "reference": "item",
                "attribute": "id",
                "types": ["azure.subnet"]
              },
              "network_security_group_id": {
                "self": "id"
              }
            },
            "requireAny": ["subnet_id"]
          }
        ]
      }
    },
    {
      "id": "azure.nat-gateway",
      "label": "NAT gateway",
      "description": "Gives the subnets it is associated with outbound connections to the internet, without a route table. A zonal NAT gateway lives in one availability zone.",
      "category": "network",
      "traits": {
        "gateway": {
          "direction": "outbound-only",
          "connects": {
            "property": "subnets"
          },
          "implicit": true
        },
        "redundancy": {
          "domains": {
            "property": "zones"
          }
        }
      },
      "accepts": [],
      "properties": {
        "subnets": {
          "type": "array",
          "title": "Subnets",
          "description": "The subnets it is associated with.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": []
        },
        "zones": {
          "type": "array",
          "title": "Availability zones",
          "description": "The availability zones it runs in. Empty: no zone is chosen, and it runs in one.",
          "items": {
            "type": "string",
            "enum": ["1", "2", "3"]
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "azurerm_nat_gateway",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          },
          "zones": {
            "property": "zones"
          }
        },
        "extra": [
          {
            "resource": "azurerm_subnet_nat_gateway_association",
            "suffix": "association",
            "each": "subnets",
            "attributes": {
              "subnet_id": {
                "reference": "item",
                "attribute": "id",
                "types": ["azure.subnet"]
              },
              "nat_gateway_id": {
                "self": "id"
              }
            },
            "requireAny": ["subnet_id"]
          }
        ],
        "notes": [
          "Add a public IP address (azurerm_public_ip) and associate it with the NAT gateway."
        ]
      }
    },
    {
      "id": "azure.vm",
      "label": "Virtual machine",
      "description": "A virtual machine. Place it in a subnet and associate network security groups with it or its subnet.",
      "category": "compute",
      "traits": {
        "endpoint": {
          "visibility": {
            "property": "endpoint"
          }
        },
        "principal": {
          "grants": {
            "property": "roleAssignments"
          }
        },
        "redundancy": {
          "domains": {
            "property": "zones"
          }
        }
      },
      "accepts": [
        {
          "actions": ["connect", "invoke"],
          "ports": ["http", "https", "ssh"]
        },
        {
          "from": {
            "category": "compute"
          },
          "actions": ["invoke"]
        }
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "title": "Endpoint",
          "description": "public: it has a public IP address. private: only a private address.",
          "enum": ["public", "private"],
          "default": "private"
        },
        "zones": {
          "type": "array",
          "title": "Availability zones",
          "description": "The availability zone it runs in. Empty: no zone is chosen.",
          "items": {
            "type": "string",
            "enum": ["1", "2", "3"]
          },
          "default": [],
          "maxItems": 1
        },
        "roleAssignments": {
          "type": "array",
          "title": "Role assignments",
          "description": "What its managed identity may do. A new identity has no role assignments.",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "title": "Resource",
                "x-component-ref": true
              },
              "access": {
                "type": "string",
                "title": "Access",
                "enum": ["read", "write", "read-write", "invoke"]
              }
            },
            "required": ["resource", "access"]
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "azurerm_linux_virtual_machine",
        "attributes": {
          "name": {
            "id": true
          },
          "location": {
            "variable": "location"
          },
          "resource_group_name": {
            "variable": "resource_group_name"
          },
          "size": {
            "variable": "vm_size"
          },
          "zone": {
            "property": "zones",
            "first": true
          }
        },
        "notes": [
          "Set admin_username, an SSH key, the OS disk, the source image and a network interface (azurerm_network_interface) in its subnet; a public endpoint needs an azurerm_public_ip."
        ]
      }
    },
    {
      "id": "azure.vm-scale-set",
      "label": "Virtual machine scale set",
      "description": "A group of equivalent virtual machines running an application. Place it in a subnet; its zones say which availability zones its instances run in.",
      "category": "compute",
      "traits": {
        "endpoint": {
          "visibility": {
            "property": "endpoint"
          }
        },
        "group": {
          "size": {
            "property": "capacity"
          }
        },
        "principal": {
          "grants": {
            "property": "roleAssignments"
          }
        },
        "redundancy": {
          "domains": {
            "property": "zones"
          }
        }
      },
      "accepts": [
        {
          "actions": ["connect", "invoke"],
          "ports": ["http", "https"]
        },
        {
          "from": {
            "category": "compute"
          },
          "actions": ["invoke"]
        }
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "title": "Endpoint",
          "description": "public: every instance has a public IP address. private: only private addresses.",
          "enum": ["public", "private"],
          "default": "private"
        },
        "capacity": {
          "type": "integer",
          "title": "Capacity",
          "description": "Number of instances. Informational only.",
          "minimum": 0,
          "default": 2
        },
        "zones": {
          "type": "array",
          "title": "Availability zones",
          "description": "The availability zones its instances run in. Empty: no zone is chosen.",
          "items": {
            "type": "string",
            "enum": ["1", "2", "3"]
          },
          "default": []
        },
        "roleAssignments": {
          "type": "array",
          "title": "Role assignments",
