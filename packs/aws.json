          "authorizes": true
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [
        {
          "actions": ["read", "invoke"],
          "ports": ["http", "https"]
        }
      ],
      "properties": {
        "origins": {
          "type": "array",
          "title": "Origins",
          "description": "Where requests go, by path pattern. Origins are reached with origin access control.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "title": "Path"
              },
              "target": {
                "type": "string",
                "title": "Target",
                "x-component-ref": true
              }
            },
            "required": ["target"]
          },
          "default": []
        }
      }
    },
    {
      "id": "aws.alb",
      "label": "Application Load Balancer",
      "description": "Distributes HTTP(S) requests to targets such as Auto Scaling groups, EC2 instances or Lambda functions. Place it in subnets and attach security groups to it. It runs in every subnet it is placed in; use subnets in two or more availability zones.",
      "category": "edge",
      "traits": {
        "endpoint": {
          "visibility": {
            "property": "scheme"
          },
          "ports": ["http", "https"]
        },
        "forwarder": {
          "routes": {
            "property": "targets"
