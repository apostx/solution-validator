          "default": "private"
        },
        "desiredCapacity": {
          "type": "integer",
          "title": "Desired capacity",
          "minimum": 0,
          "default": 2
        },
        "permissions": {
          "type": "array",
          "title": "Permissions",
          "description": "What the instances' role may do.",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "title": "Resource",
