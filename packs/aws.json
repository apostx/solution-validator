    {
      "id": "aws.cloudfront",
      "label": "CloudFront distribution",
      "description": "A content delivery network in front of origins such as S3 buckets, load balancers or APIs. With origin access control it may read its S3 origins even when they block public access.",
      "category": "edge",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "ports": ["http", "https"]
        },
        "forwarder": {
          "routes": {
            "property": "origins"
