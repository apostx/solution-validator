        {
          "actions": ["connect", "invoke"],
          "ports": ["http", "https"]
        },
        {
          "from": {
            "category": "compute"
          },
          "actions": ["invoke"]
        }
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "title": "Endpoint",
          "description": "public: the instances have public addresses. private: they are reachable only inside the VPC.",
