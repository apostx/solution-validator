{
  "$schema": "../schemas/pack.schema.json",
  "id": "aws",
  "version": "0.7.0",
  "label": "Amazon Web Services",
  "description": "Serverless (API Gateway, Lambda, DynamoDB, S3), web (CloudFront, Application Load Balancer, EC2, Auto Scaling, RDS) and networking (VPC, subnets, gateways, VPC endpoints, IPv6, route tables, security groups, network ACLs).",
  "vocabulary": 6,
  "requires": {
    "core": "^0.2.0"
  },
  "types": [
    {
      "id": "aws.api-gateway",
      "label": "API Gateway",
      "description": "A managed HTTPS API that routes requests to integrations such as Lambda functions.",
      "category": "edge",
      "traits": {
        "endpoint": {
          "visibility": {
            "property": "endpoint"
          },
          "ports": ["https"]
        },
        "forwarder": {
          "routes": {
            "property": "routes"
          },
          "authorizes": true
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [
        {
          "actions": ["invoke"],
          "ports": ["https"]
        }
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "title": "Endpoint type",
          "description": "public: reachable from the internet. private: reachable only from inside a private network.",
          "enum": ["public", "private"],
          "default": "public"
        },
        "routes": {
          "type": "array",
          "title": "Routes",
          "description": "Each route forwards requests on a path to a target. A route also grants the API permission to invoke its target.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "title": "Path",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "title": "Target",
                "x-component-ref": true
              }
            },
            "required": ["path", "target"]
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "aws_apigatewayv2_api",
        "attributes": {
          "name": {
            "id": true
          },
          "protocol_type": {
            "value": "HTTP"
          }
        },
        "notes": [
          "Routes, integrations and a stage (aws_apigatewayv2_route, aws_apigatewayv2_integration, aws_apigatewayv2_stage) are not exported. A private endpoint needs a REST API instead."
        ]
      }
    },
    {
      "id": "aws.lambda",
      "label": "Lambda function",
      "description": "Runs code on demand. Its execution role decides what it may access. It is invoked through the Lambda API; placed in a VPC's subnets, its outbound traffic goes through the VPC.",
      "category": "compute",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "via": "provider"
        },
        "principal": {
          "grants": {
            "property": "permissions"
          }
        },
        "access-controlled": {
          "levels": {
            "invoke": ["invoke"]
          }
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [
        {
          "from": {
            "type": "aws.api-gateway"
          },
          "actions": ["invoke"]
        },
        {
          "from": {
            "category": "compute"
          },
          "actions": ["invoke"]
        },
        {
          "from": {
            "type": "aws.alb"
          },
          "actions": ["invoke"]
        }
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "title": "Runtime",
          "description": "For example nodejs22.x or python3.13. Informational only."
        },
        "permissions": {
          "type": "array",
          "title": "Permissions",
          "description": "What the function's execution role may do. A new function has no permissions on other resources.",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "title": "Resource",
                "x-component-ref": true
              },
              "access": {
                "type": "string",
                "title": "Access",
                "enum": ["read", "write", "read-write", "invoke"]
              }
            },
            "required": ["resource", "access"]
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "aws_lambda_function",
        "attributes": {
          "function_name": {
            "id": true
          },
          "runtime": {
            "property": "runtime"
          }
        },
        "blocks": [
          {
            "name": "vpc_config",
            "attributes": {
              "subnet_ids": {
                "reference": "placement",
                "attribute": "id",
                "list": true
              },
              "security_group_ids": {
                "referencedBy": {
                  "type": "aws.security-group",
                  "property": "attachedTo"
                },
                "attribute": "id"
              }
            },
            "requireAny": ["subnet_ids"]
          }
        ],
        "notes": [
          "Set role (an IAM role whose policies grant its permissions), handler and the code (filename or image_uri)."
        ]
      }
    },
    {
      "id": "aws.dynamodb",
      "label": "DynamoDB table",
      "description": "A managed NoSQL table. Access requires a permission grant.",
      "category": "data-store",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "ports": ["https"]
        },
        "access-controlled": {
          "levels": {
            "read": ["read"],
            "write": ["write"],
            "read-write": ["read", "write"]
          }
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [
        {
          "from": {
            "category": "compute"
          },
          "actions": ["read", "write"]
        }
      ],
      "terraform": {
        "resource": "aws_dynamodb_table",
        "attributes": {
          "name": {
            "id": true
          }
        },
        "notes": [
          "Set hash_key with its attribute block, and billing_mode or the read and write capacities."
        ]
      }
    },
    {
      "id": "aws.s3",
      "label": "S3 bucket",
      "description": "Object storage. Access requires a permission grant unless public access is enabled.",
      "category": "data-store",
      "traits": {
        "endpoint": {
          "visibility": "public",
          "ports": ["https"]
        },
        "access-controlled": {
          "levels": {
            "read": ["read"],
            "write": ["write"],
            "read-write": ["read", "write"]
          },
          "public": {
            "property": "publicAccess"
          },
          "publicActions": ["read"]
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [
        {
          "from": {
            "category": "compute"
          },
          "actions": ["read", "write"]
        },
        {
          "from": {
            "category": "external"
          },
          "actions": ["read"],
          "ports": ["https"]
        },
        {
          "from": {
            "type": "aws.cloudfront"
          },
          "actions": ["read"]
        }
      ],
      "properties": {
        "publicAccess": {
          "type": "boolean",
          "title": "Public access",
          "description": "Whether anyone on the internet may read objects. New buckets block public access by default.",
          "default": false
        }
      },
      "terraform": {
        "resource": "aws_s3_bucket",
        "attributes": {
          "bucket": {
            "id": true
          }
        },
        "extra": [
          {
            "resource": "aws_s3_bucket_public_access_block",
            "suffix": "public_access",
            "attributes": {
              "bucket": {
                "self": "id"
              },
              "block_public_acls": {
                "property": "publicAccess",
                "map": {
                  "true": false,
                  "false": true
                },
                "default": false
              },
              "block_public_policy": {
                "property": "publicAccess",
                "map": {
                  "true": false,
                  "false": true
                },
                "default": false
              },
              "ignore_public_acls": {
                "property": "publicAccess",
                "map": {
                  "true": false,
                  "false": true
                },
                "default": false
              },
              "restrict_public_buckets": {
                "property": "publicAccess",
                "map": {
                  "true": false,
                  "false": true
                },
                "default": false
              }
            }
          }
        ],
        "notes": [
          "Public reads also need a bucket policy (aws_s3_bucket_policy), which is not exported."
        ]
      }
    },
    {
      "id": "aws.vpc",
      "label": "VPC",
      "description": "A private network. Components placed in its subnets reach each other through local routes, subject to security groups and network ACLs.",
      "category": "network",
      "traits": {
        "zone": {
          "addressSpace": {
            "property": "cidrBlock"
          },
          "ipv6AddressSpace": {
            "property": "ipv6CidrBlock"
          }
        }
      },
      "accepts": [],
      "properties": {
        "cidrBlock": {
          "type": "string",
          "title": "CIDR block",
          "description": "The VPC's IPv4 address range, for example 10.0.0.0/16. Used by the detailed analysis level.",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        },
        "ipv6CidrBlock": {
          "type": "string",
          "title": "IPv6 CIDR block",
          "description": "The VPC's IPv6 address range, for example 2600:1f18:1234:5600::/56. Optional: a VPC without one has no IPv6 addresses. Used by the detailed analysis level.",
          "pattern": "^[0-9a-fA-F:]+/[0-9]{1,3}$"
        }
      },
      "terraform": {
        "resource": "aws_vpc",
        "attributes": {
          "cidr_block": {
            "property": "cidrBlock"
          },
          "ipv6_cidr_block": {
            "property": "ipv6CidrBlock"
          }
        }
      }
    },
    {
      "id": "aws.subnet",
      "label": "Subnet",
      "description": "A part of a VPC; place it in the VPC. Its route table decides whether it reaches the internet, and its network ACL filters traffic that enters or leaves it.",
      "category": "network",
      "traits": {
        "zone": {
          "addressSpace": {
            "property": "cidrBlock"
          },
          "failureDomain": {
            "property": "availabilityZone"
          },
          "ipv6AddressSpace": {
            "property": "ipv6CidrBlock"
          }
        }
      },
      "accepts": [],
      "properties": {
        "cidrBlock": {
          "type": "string",
          "title": "CIDR block",
          "description": "The subnet's IPv4 address range within its VPC, for example 10.0.1.0/24. Used by the detailed analysis level.",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        },
        "availabilityZone": {
          "type": "string",
          "title": "Availability zone",
          "description": "For example eu-west-1a. Used by the availability analysis.",
          "minLength": 1
        },
        "ipv6CidrBlock": {
          "type": "string",
          "title": "IPv6 CIDR block",
          "description": "The subnet's IPv6 range within its VPC's, a /64 such as 2600:1f18:1234:5601::/64. Optional. Used by the detailed analysis level.",
          "pattern": "^[0-9a-fA-F:]+/[0-9]{1,3}$"
        }
      },
      "terraform": {
        "resource": "aws_subnet",
        "attributes": {
          "vpc_id": {
            "reference": "placement",
            "attribute": "id",
            "types": ["aws.vpc"]
          },
          "cidr_block": {
            "property": "cidrBlock"
          },
          "ipv6_cidr_block": {
            "property": "ipv6CidrBlock"
          },
          "availability_zone": {
            "property": "availabilityZone"
          }
        }
      }
    },
    {
      "id": "aws.internet-gateway",
      "label": "Internet gateway",
      "description": "Connects a VPC to the internet in both directions. A subnet whose route table sends internet traffic here is a public subnet.",
      "category": "network",
      "traits": {
        "gateway": {
          "direction": "both",
          "connects": {
            "property": "attachedTo"
          }
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [],
      "properties": {
        "attachedTo": {
          "type": "array",
          "title": "Attached to",
          "description": "The VPC the gateway is attached to.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": [],
          "maxItems": 1
        }
      },
      "terraform": {
        "resource": "aws_internet_gateway",
        "attributes": {
          "vpc_id": {
            "reference": "attachedTo",
            "attribute": "id"
          }
        }
      }
    },
    {
      "id": "aws.egress-only-internet-gateway",
      "label": "Egress-only internet gateway",
      "description": "Lets a VPC's subnets open IPv6 connections to the internet, but not the other way round. Attach it to the VPC and route ::/0 to it.",
      "category": "network",
      "traits": {
        "gateway": {
          "direction": "outbound-only",
          "connects": {
            "property": "attachedTo"
          },
          "families": [6]
        },
        "redundancy": {
          "managed": true
        }
      },
      "accepts": [],
      "properties": {
        "attachedTo": {
          "type": "array",
          "title": "Attached to",
          "description": "The VPC it is attached to.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": [],
          "maxItems": 1
        }
      },
      "terraform": {
        "resource": "aws_egress_only_internet_gateway",
        "attributes": {
          "vpc_id": {
            "reference": "attachedTo",
            "attribute": "id"
          }
        }
      }
    },
    {
      "id": "aws.nat-gateway",
      "label": "NAT gateway",
      "description": "Lets private subnets open IPv4 connections to the internet, but not the other way round; for IPv6, use an egress-only internet gateway. Place it in a public subnet. A NAT gateway lives in one availability zone; use one per zone for resilience.",
      "category": "network",
      "traits": {
        "gateway": {
          "direction": "outbound-only",
          "families": [4]
        }
      },
      "accepts": [],
      "terraform": {
        "resource": "aws_nat_gateway",
        "attributes": {
          "subnet_id": {
            "reference": "placement",
            "attribute": "id"
          }
        },
        "notes": ["A public NAT gateway needs an Elastic IP: add an aws_eip and set allocation_id."]
      }
    },
    {
      "id": "aws.route-table",
      "label": "Route table",
      "description": "Decides where traffic leaving its subnets goes. Associated with the VPC itself, it is the main route table for subnets without their own.",
      "category": "network",
      "traits": {
        "router": {
          "routes": {
            "property": "routes"
          },
          "zones": {
            "property": "associations"
          }
        }
      },
      "accepts": [],
      "properties": {
        "routes": {
          "type": "array",
          "title": "Routes",
          "description": "Routes besides the local route of the VPC.",
          "items": {
            "type": "object",
            "properties": {
              "destination": {
                "type": "string",
                "title": "Destination",
                "description": "internet (both address families), an IPv4 or IPv6 range such as 0.0.0.0/0 or ::/0 (the detailed level matches the longest prefix of the traffic's family), or the id of a service a gateway endpoint reaches (for example a DynamoDB table).",
                "minLength": 1
              },
              "gateway": {
                "type": "string",
                "title": "Gateway",
                "x-component-ref": true
              }
            },
            "required": ["destination", "gateway"]
          },
          "default": []
        },
        "associations": {
          "type": "array",
          "title": "Associations",
          "description": "The subnets (or the VPC) this route table serves.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "aws_route_table",
        "attributes": {
          "vpc_id": {
            "reference": "associations",
            "attribute": "id",
            "network": true,
            "types": ["aws.vpc"]
          }
        },
        "blocks": [
          {
            "name": "route",
            "each": "routes",
            "attributes": {
              "cidr_block": {
                "property": "destination",
                "map": {
                  "internet": "0.0.0.0/0"
                },
                "family": 4
              },
              "ipv6_cidr_block": {
                "property": "destination",
                "family": 6
              },
              "gateway_id": {
                "reference": "gateway",
                "attribute": "id",
                "types": ["aws.internet-gateway"]
              },
              "nat_gateway_id": {
                "reference": "gateway",
                "attribute": "id",
                "types": ["aws.nat-gateway"]
              },
              "egress_only_gateway_id": {
                "reference": "gateway",
                "attribute": "id",
                "types": ["aws.egress-only-internet-gateway"]
              }
            },
            "requireAny": ["cidr_block", "ipv6_cidr_block"]
          }
        ],
        "extra": [
          {
            "resource": "aws_route_table_association",
            "suffix": "association",
            "each": "associations",
            "attributes": {
              "subnet_id": {
                "reference": "item",
                "attribute": "id",
                "types": ["aws.subnet"]
              },
              "route_table_id": {
                "self": "id"
              }
            },
            "requireAny": ["subnet_id"]
          }
        ],
        "notes": [
          "Routes to services through a gateway endpoint become aws_vpc_endpoint_route_table_association resources, which are not exported."
        ]
      }
    },
    {
      "id": "aws.security-group",
      "label": "Security group",
      "description": "A stateful firewall for the components it is attached to: replies to allowed traffic are allowed automatically.",
      "category": "network",
      "traits": {
        "traffic-filter": {
          "stateful": true,
          "attachTo": ["component"],
          "rules": {
            "property": "rules"
          },
          "targets": {
            "property": "attachedTo"
          },
          "default": {
            "inbound": "deny",
            "outbound": "deny"
          }
        }
      },
      "accepts": [],
      "properties": {
        "rules": {
          "type": "array",
          "title": "Rules",
          "description": "Allowed traffic. peer: any, internet, or the id of a component, subnet, VPC or security group. A new security group allows all outbound traffic and no inbound traffic.",
          "items": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "title": "Direction",
                "enum": ["inbound", "outbound"]
              },
              "peer": {
                "type": "string",
                "title": "Peer",
                "minLength": 1,
                "description": "any, internet, the id of a component, subnet, VPC or security group, or an IPv4 or IPv6 range such as 10.0.0.0/16 or ::/0 (matched at the detailed level; a range only matches traffic of its own address family)."
              },
              "ports": {
                "type": "array",
                "title": "Ports",
                "items": {
                  "type": "string"
                },
                "description": "Port ids (https), numbers (443) or ranges (1024-65535). Omitted: all ports."
              }
            },
            "required": ["direction", "peer"]
          },
          "default": [
            {
              "direction": "outbound",
              "peer": "any"
            }
          ]
        },
        "attachedTo": {
          "type": "array",
          "title": "Attached to",
          "description": "The components the security group protects.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "aws_security_group",
        "attributes": {
          "name": {
            "id": true
          },
          "vpc_id": {
            "reference": "attachedTo",
            "attribute": "id",
            "network": true,
            "types": ["aws.vpc"]
          }
        },
        "blocks": [
          {
            "name": "ingress",
            "each": "rules",
            "where": {
              "direction": "inbound"
            },
            "expand": "ports",
            "attributes": {
              "from_port": {
                "port": "from",
                "property": "ports"
              },
              "to_port": {
                "port": "to",
                "property": "ports"
              },
              "protocol": {
                "port": "protocol",
                "property": "ports"
              },
              "cidr_blocks": {
                "property": "peer",
                "map": {
                  "internet": "0.0.0.0/0",
                  "any": "0.0.0.0/0"
                },
                "family": 4,
                "list": true
              },
              "ipv6_cidr_blocks": {
                "property": "peer",
                "family": 6,
                "list": true
              },
              "security_groups": {
                "reference": "peer",
                "attribute": "id",
                "types": ["aws.security-group"],
                "list": true
              }
            },
            "requireAny": ["cidr_blocks", "ipv6_cidr_blocks", "security_groups"]
          },
          {
            "name": "egress",
            "each": "rules",
            "where": {
              "direction": "outbound"
            },
            "expand": "ports",
            "attributes": {
              "from_port": {
                "port": "from",
                "property": "ports"
              },
              "to_port": {
                "port": "to",
                "property": "ports"
              },
              "protocol": {
                "port": "protocol",
                "property": "ports"
              },
              "cidr_blocks": {
                "property": "peer",
                "map": {
                  "internet": "0.0.0.0/0",
                  "any": "0.0.0.0/0"
                },
                "family": 4,
                "list": true
              },
              "ipv6_cidr_blocks": {
                "property": "peer",
                "family": 6,
                "list": true
              },
              "security_groups": {
                "reference": "peer",
                "attribute": "id",
                "types": ["aws.security-group"],
                "list": true
              }
            },
            "requireAny": ["cidr_blocks", "ipv6_cidr_blocks", "security_groups"]
          }
        ]
      }
    },
    {
      "id": "aws.network-acl",
      "label": "Network ACL",
      "description": "A stateless firewall for the subnets it is associated with: rules are checked in order, and replies need rules of their own.",
      "category": "network",
      "traits": {
        "traffic-filter": {
          "stateful": false,
          "attachTo": ["zone"],
          "rules": {
            "property": "rules"
          },
          "targets": {
            "property": "subnets"
          },
          "default": {
            "inbound": "deny",
            "outbound": "deny"
          }
        }
      },
      "accepts": [],
      "properties": {
        "rules": {
          "type": "array",
          "title": "Rules",
          "description": "Checked in order; the first match decides. Replies need rules of their own: at the detailed level they use the ephemeral ports 1024-65535. The default network ACL allows everything.",
          "items": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "title": "Direction",
                "enum": ["inbound", "outbound"]
              },
              "peer": {
                "type": "string",
                "title": "Peer",
                "minLength": 1,
                "description": "any, internet, the id of a component, subnet, VPC or security group, or an IPv4 or IPv6 range such as 10.0.0.0/16 or ::/0 (matched at the detailed level; a range only matches traffic of its own address family)."
              },
              "ports": {
                "type": "array",
                "title": "Ports",
                "items": {
                  "type": "string"
                },
                "description": "Port ids (https), numbers (443) or ranges (1024-65535). Omitted: all ports."
              },
              "effect": {
                "type": "string",
                "title": "Effect",
                "enum": ["allow", "deny"]
              }
            },
            "required": ["direction", "peer"]
          },
          "default": [
            {
              "direction": "inbound",
              "peer": "any",
              "effect": "allow"
            },
            {
              "direction": "outbound",
              "peer": "any",
              "effect": "allow"
            }
          ]
        },
        "subnets": {
          "type": "array",
          "title": "Subnets",
          "description": "The subnets the network ACL is associated with.",
          "items": {
            "type": "string",
            "x-component-ref": true
          },
          "default": []
        }
      },
      "terraform": {
        "resource": "aws_network_acl",
        "attributes": {
          "vpc_id": {
            "reference": "subnets",
            "attribute": "id",
            "network": true,
            "types": ["aws.vpc"]
          },
          "subnet_ids": {
            "reference": "subnets",
            "attribute": "id",
            "list": true
          }
        },
        "notes": ["Rules are not exported: add ingress and egress blocks with rule numbers."]
      }
    },
    {
      "id": "aws.autoscaling-group",
      "label": "Auto Scaling group",
      "description": "A group of equivalent EC2 instances running an application. Place it in one or more subnets; attach security groups to it.",
