          "authorizes": true
        }
      },
      "accepts": [
        {
          "actions": ["invoke", "read"],
          "ports": ["http", "https"]
        }
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "title": "Scheme",
          "description": "public: internet-facing. private: internal, reachable only inside the VPC.",
          "enum": ["public", "private"],
          "default": "public"
        },
        "targets": {
          "type": "array",
          "title": "Targets",
          "description": "The target groups' targets, by path pattern.",
          "items": {
            "type": "object",
