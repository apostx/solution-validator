          "subnets": {
            "reference": "placement",
            "attribute": "id",
            "list": true
          },
          "security_groups": {
            "referencedBy": {
              "type": "aws.security-group",
              "property": "attachedTo"
            },
            "attribute": "id"
          }
        },
        "notes": [
