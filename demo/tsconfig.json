{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "solution-validator": ["../src/index.ts"],
      "solution-validator/packs/*": ["../src/packs/*.ts"]
    },
    "tsBuildInfoFile": "../node_modules/.cache/tsc/demo.tsbuildinfo"
  },
  "include": ["src", "vite.config.ts"]
}
