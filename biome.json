{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.release-please-manifest.json", "!schemas", "!test/fixtures/expected"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tsconfig*.json", "demo/tsconfig.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "Library code must be deterministic: do not read the clock.",
                  "Intl": "Library code must be deterministic: do not use locale-dependent formatting.",
                  "process": "Library code runs in browsers too: do not use Node.js globals.",
                  "Buffer": "Library code runs in browsers too: do not use Node.js globals.",
                  "fetch": "Library code must not access the network; callers pass packs in."
                }
              }
            }
          }
        }
      }
    }
  ]
}
