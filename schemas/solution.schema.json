{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "packs",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "placement": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "properties": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "meta": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
            "maxLength": 128
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            ]
          },
          "meta": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    }
  },
  "additionalProperties": false,
  "title": "SolutionValidator solution"
}
